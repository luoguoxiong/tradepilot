# ===== 应用 =====
NODE_ENV="development"
PORT=3020

# ===== 数据库（docker compose 起 tradepilot-postgres，端口 5435）=====
DATABASE_URL="postgresql://tradepilot:tradepilot@127.0.0.1:5435/tradepilot"

# ===== Redis（docker compose 起 tradepilot-redis，端口 6393）=====
REDIS_URL="redis://127.0.0.1:6393"

# ===== 安全 =====
# integrations 表 API Key 的 AES-256-GCM 加密密钥（32 字节 hex，openssl rand -hex 32）
APP_ENCRYPTION_KEY=""
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ===== LLM（OpenAI 兼容 → DeepSeek；无 Key 时 AI 功能走确定性规则降级并标注 mock）=====
# 模型 ID 见官方文档：https://api-docs.deepseek.com/api/create-chat-completion（deepseek-flash / deepseek-v4-pro）
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-flash"

# ===== 第三方 API Key（无 Key 时对应 Adapter 自动降级 Mock，数据标注 DEMO）=====
SERPER_API_KEY=""
APOLLO_API_KEY=""
CUSTOMS_API_KEY=""
CUSTOMS_API_PROVIDER=""

# ===== 成本控制 =====
# 第三方 API 日配额（Redis 计数，超出记步骤失败）
ADAPTER_DAILY_QUOTA_SERPER="100"
ADAPTER_DAILY_QUOTA_APOLLO="100"
ADAPTER_DAILY_QUOTA_CUSTOMS="100"
# 每任务 AI 评分企业数上限（超出标记 skipped，可单独触发）
TASK_SCORE_LIMIT="10"
