{
  "name": "tradepilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "style:lint": "stylelint \"src/**/*.{scss,css,vue}\" --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky web/.husky"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,vue}": [
      "stylelint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.14",
    "element-plus": "^2.14.5",
    "lodash-es": "^4.18.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.42",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
