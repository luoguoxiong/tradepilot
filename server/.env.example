# ===== 数据库（docker compose 与 app 共用；凭据需与 docker/docker-compose.yml 一致）=====
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=tradepilot_dev
POSTGRES_DB=tradepilot
POSTGRES_PORT=5432

# 业务连接（必须为 tradepilot_app：RLS 生效角色；superuser/BYPASSRLS 会绕过租户隔离）
DATABASE_URL=postgresql://tradepilot_app:changeme_app@localhost:5432/tradepilot
# 调度扫描连接（tradepilot_sched，白名单表跨租户）——M2 启用
SCHED_DATABASE_URL=postgresql://tradepilot:tradepilot_dev@localhost:5432/tradepilot
# 迁移连接（表 owner；DDL/建表/授权只跑在这条连接上，运行时角色不持有 DDL 权限）
MIGRATE_DATABASE_URL=postgresql://tradepilot:tradepilot_dev@localhost:5432/tradepilot

# ===== Redis（BullMQ + Pub/Sub + 限流/令牌桶）=====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===== 安全 =====
# JWT 会话签名密钥（生产必须轮换；HS256，预留 kid）
JWT_SECRET=dev_only_change_me_0123456789abcdef0123456789abcdef
# 凭据加密主密钥（08 §2，32 字节 hex）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== 应用 =====
API_PORT=3000
LOG_LEVEL=debug
NODE_ENV=development
# 雪花机器位（worker 多实例部署时按序分配）
WORKER_INDEX=1
# 该 worker 实例消费的队列组（逗号分隔，缺省=全部）
# WORKER_QUEUES=q:lead_hunting,q:email_reply
# langgraph checkpoint 表由 manual 迁移 0009 建立；仅在依赖升级需补列时才置 true
# （运行时角色无数据库级 CREATE 权限，setup() 会 42501）
# LANGGRAPH_CHECKPOINT_SETUP=false

# ===== 对象存储（dev 用 MinIO；生产 S3 兼容）=====
MINIO_ROOT_USER=tradepilot
MINIO_ROOT_PASSWORD=tradepilot_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJ_STORE_ENDPOINT=http://localhost:9000
OBJ_STORE_BUCKET=tradepilot-dev
OBJ_STORE_AK=tradepilot
OBJ_STORE_SK=tradepilot_dev

# ===== 外部服务密钥（M4 启用）=====
# LLM_PROVIDER_KEYS_OPENAI=sk-xxx
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

# ===== 邮箱 OAuth 客户端（M4 #4/#5，gmail/outlook 驱动；未配置仅影响对应 provider）=====
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ===== 可观测（M6 启用）=====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# ===== 紧急开关 =====
# OUTBOUND_EMAIL_DISABLED=false
