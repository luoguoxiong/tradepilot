{
  "name": "@tradepilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tradepilot/core": "workspace:*",
    "@tradepilot/db": "workspace:*",
    "@tradepilot/runtime": "workspace:*",
    "@tradepilot/shared": "workspace:*",
    "@tradepilot/tools": "workspace:*",
    "@tradepilot/workflows": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
