    "@tradepilot/integrations": "workspace:*",
    "@tradepilot/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  }
}
