// TradePilot AI — PostgreSQL Schema (Prisma)
// 基线：docs/architecture.md v1.1、plan.md 第五节 11 张表 + task_step_logs + audit_logs
// 多租户预留：全表 tenant_id（默认 'default'），MVP 不做隔离逻辑

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

/// CRM 客户状态机：null（companies.crmStatus）= 未导入 CRM
enum CrmStatus {
  NEW
  QUALIFIED
  CONTACTED
  REPLIED
  NEGOTIATING
  WON
  LOST
}

/// 编排任务状态机（docs/architecture.md §3.1）
enum TaskStatus {
  PENDING
  SEARCHING
  ENRICHING
  SCORING
  EMAILING
  DONE
  FAILED
}

/// enriching 内部子步
enum EnrichSubstep {
  CONTACTS
  CUSTOMS
  ENRICH
}

/// 企业粒度子任务状态（含 skipped：超出 LLM 评分上限等）
enum SubtaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

/// AI 评分状态（skipped = 超出每任务评分上限，可在 Company Detail 单独触发）
enum ScoreStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

/// 客户等级：A 80-100 / B 60-79 / C 40-59 / D 0-39
enum Grade {
  A
  B
  C
  D
}

enum EmailVerified {
  VERIFIED
  UNVERIFIED
  UNKNOWN
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  FOLLOW_UP
}

// ---------- 1. users：用户 ----------

model User {
  id           String   @id @default(cuid())
  tenantId     String   @default("default") // 多租户预留
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]
  searchTasks    SearchTask[]
  activities     CrmActivity[]
  integrations   Integration[]
  auditLogs      AuditLog[]
  ownedCompanies Company[] @relation("CompanyOwner")

  @@index([tenantId])
}

// ---------- 2. products：我方产品 ----------

model Product {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  description  String?
  sellingPoints String[] // 核心卖点
  keywords     String[]  // 产品关键词（搜索任务默认值）
  companyIntro String?   // 我方公司介绍（开发信输入）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  searchTasks SearchTask[]

  @@index([userId])
}

// ---------- 3. companies：海外企业 ----------
// 去重主键 dedupeKey = 域名；无官网时由名称生成指纹（架构 §4.2）
// CRM 客户即 crmStatus 非空的 company（轻量 CRM，/api/crm/customers 映射到此筛选）

model Company {
  id             String    @id @default(cuid())
  tenantId       String    @default("default")
  dedupeKey      String    @unique
  name           String
  website        String?
  country        String
  description    String?
  mainProducts   String[]
  email          String?
  linkedinUrl    String?
  source         String // 'google' | 'apollo' | 'demo' | ...
  isFavorite     Boolean   @default(false)
  searchedAt     DateTime  @default(now())
  crmStatus      CrmStatus?
  nextFollowUpAt DateTime?
  ownerUserId    String? // 导入 CRM 后的负责人
  owner          User?     @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contacts        Contact[]
  customsRecords  CustomsRecord[]
  leadScores      LeadScore[]
  emailDrafts     EmailDraft[]
  activities      CrmActivity[]
  enrichmentTasks EnrichmentTask[]

  @@index([tenantId, country])
  @@index([crmStatus]) // CRM 按状态筛选高频路径
  @@index([name])
}

// ---------- 4. contacts：采购联系人 ----------
// 去重：(companyId, email) 唯一；email 可空（手动补充尚未获得邮箱的联系人，Postgres 多 NULL 不冲突）

model Contact {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  name          String
  title         String
  email         String?
  linkedinUrl   String?
  country       String?
  source        String
  emailVerified EmailVerified @default(UNKNOWN)
  isManual      Boolean       @default(false) // 手动补充（API 失败兜底）
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  emailDrafts EmailDraft[]

  @@unique([companyId, email])
  @@index([companyId])
}

// ---------- 5. customs_records：海关采购记录 ----------
// 单条原始记录粒度；采购频率等企业级聚合由服务层计算（架构 §4.5）

model CustomsRecord {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  companyName        String
  importCountry      String
  productDescription String?
  hsCode             String?
  shipmentDate       DateTime
  quantity           String?
  supplierCountry    String?
  supplierName       String?
  source             String // 'customs:xxx' | 'demo'
  createdAt          DateTime @default(now())

  @@index([companyId, shipmentDate(sort: Desc)])
}

// ---------- 6. lead_scores：AI 客户评分 ----------
// 六项解释性输出缺一不可（PRD §3.4）

model LeadScore {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  status           ScoreStatus  @default(PENDING)
  score            Int? // 0-100
  grade            Grade?
  matchReasons     String[] // 客户匹配原因
  purchaseNeeds    String? // 潜在采购需求
  opportunities    String? // 可能的合作机会
  suggestions      String? // 客户开发建议
  uncertaintyNotes String? // 数据缺失和不确定性说明
  subScores        Json? // 五维得分 { product, business, customs, contact, region }
  model            String?
  promptTokens     Int?
  completionTokens Int?
  error            String?
  createdAt        DateTime     @default(now())

  @@index([companyId, createdAt(sort: Desc)])
}

// ---------- 7. email_drafts：开发信草稿 ----------
// MVP 仅草稿，无发送（PRD 硬性规则）

model EmailDraft {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])
  subject    String
  body       String
  followUp1  String?
  followUp2  String?
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, createdAt(sort: Desc)])
}

// ---------- 8. crm_activities：客户跟进记录 ----------

model CrmActivity {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  type           ActivityType
  content        String
  nextFollowUpAt DateTime? // 设置时同步写 company.nextFollowUpAt（服务层）
  createdAt      DateTime     @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([nextFollowUpAt]) // Dashboard 待跟进卡片
}

// ---------- 9. search_tasks：编排任务主表（状态机载体） ----------

model SearchTask {
  id                String     @id @default(cuid())
  tenantId          String     @default("default")
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  productId         String?
  product           Product?   @relation(fields: [productId], references: [id])
  params            Json // { productKeywords, country, companyTypes, industryKeywords, limit }
  status            TaskStatus @default(PENDING)
  totalCompanies    Int        @default(0)
  processedCompanies Int       @default(0)
  skippedCount      Int        @default(0)
  failedCount       Int        @default(0)
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  steps           TaskStepLog[]
  enrichmentTasks EnrichmentTask[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status]) // 对账扫描中间态任务
}

// ---------- 10. enrichment_tasks：企业粒度补充子任务 ----------
// 支撑单企业失败可见、可单独重试（架构 §3.2）

model EnrichmentTask {
  id           String         @id @default(cuid())
  searchTaskId String
  searchTask   SearchTask     @relation(fields: [searchTaskId], references: [id])
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  substep      EnrichSubstep
  status       SubtaskStatus  @default(PENDING)
  error        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([searchTaskId, companyId, substep])
  @@index([searchTaskId])
  @@index([companyId])
}

// ---------- 11. task_step_logs：步骤/子步执行日志 ----------

model TaskStepLog {
  id         String    @id @default(cuid())
  taskId     String
  searchTask SearchTask @relation(fields: [taskId], references: [id])
  step       String // 'searching' | 'enriching:contacts' | ... （与 fromStep 枚举对齐）
  status     String // STARTED | DONE | FAILED
  detail     String?
  companyId  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([taskId, startedAt])
}

// ---------- 12. integrations：第三方 API 配置 ----------
// encryptedConfig = AES-256-GCM 密文（架构 §5），API 响应只回尾 4 位掩码

model Integration {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  provider        String // 'google' | 'apollo' | 'customs' | ...
  encryptedConfig String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}

// ---------- 13. audit_logs：用户操作审计（架构 §5"重要操作记录日志"） ----------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // 'auth.login' | 'crm.status_change' | 'crm.import' | ...
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
