PORT=8787
# LLM（OpenAI 兼容协议）：DeepSeek / Qwen / GLM / OpenAI 任选
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=
# 搜索引擎：duckduckgo | tavily | serpapi | google_cse
# 说明：DuckDuckGo 免费免key（中国大陆网络不可达，海外可用）；
#       tavily 免费 1000 次/月（国内可达，推荐）；serpapi 需付费 key（国内可达）；
#       google_cse 需配置 key（国内不可达）。
# 配置了多个源时会自动级联降级。
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-xxx
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
SERPAPI_KEY=
# 抓取配置
SCRAPED_PAGE_LIMIT=5
FETCH_TIMEOUT_MS=15000

# ===== 二期：订单跟单 =====
# SMTP 密码加密密钥素材（建议配置随机长字符串；未配置时回退用 LLM_API_KEY 派生）
APP_SECRET=
# 订单异常扫描间隔（毫秒，默认 30 分钟）
ORDER_SCAN_INTERVAL_MS=1800000
