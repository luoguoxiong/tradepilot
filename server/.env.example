# 数据库（docker compose 起 tradepilot-postgres，端口 5435）
DATABASE_URL="postgresql://tradepilot:tradepilot@127.0.0.1:5435/tradepilot"

# Redis（docker compose 起 tradepilot-redis，端口 6393）
REDIS_URL="redis://127.0.0.1:6393"

# 应用加密密钥（integrations 表 API Key 的 AES-256-GCM 加密；32 字节 hex）
APP_ENCRYPTION_KEY=""

# JWT
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# LLM（OpenAI 兼容 → DeepSeek；无 Key 时 AI 功能将报结构化错误）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 第三方 API Key（无 Key 时对应 Adapter 自动降级 Mock，数据标注 DEMO）
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""
APOLLO_API_KEY=""
CUSTOMS_API_KEY=""
CUSTOMS_API_PROVIDER=""

# 第三方 API 日配额（超出记步骤失败）
ADAPTER_DAILY_QUOTA_GOOGLE="100"
ADAPTER_DAILY_QUOTA_APOLLO="100"
ADAPTER_DAILY_QUOTA_CUSTOMS="100"

# 每任务 AI 评分企业数上限（超出标记 skipped，可单独触发）
TASK_SCORE_LIMIT="10"
