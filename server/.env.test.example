# ===== 测试 provider 配置（复制为 server/.env.test 后填写真实值）=====
# 用途：api / worker 集成测试装配真实 provider（不再有 mock 兜底）。
# 约束：文件缺失，或下表中标 [必填] 的项缺失/非法 → 测试装配直接抛错，全部用例 fail-fast。
# 注意：.env.test 已被 .gitignore 忽略（仅提交本示例），密钥不入库。

# ----- LLM 大语言模型 [必填] -----
# provider ∈ openai | anthropic | deepseek | azure（与 LlmGateway/llm-probe 口径一致）
# 模型须为该端点/账号实际开放且支持 chat + JSON 输出（response_format=json_object）的模型；
# 火山 coding plan 端点（…/api/coding/v3）只放行白名单模型，非白名单返回
# 404 "does not support the coding plan feature"（实测可用：doubao-seed-code-preview-251028）
TEST_LLM_PROVIDER=deepseek
TEST_LLM_MODEL=deepseek-chat
# 复制为 .env.test 后替换为真实 API Key（示例仅占位，密钥不入库）
TEST_LLM_API_KEY=sk-REPLACE_WITH_REAL_KEY
# 可选：openai/azure 兼容端点（deepseek/anthropic 走各自默认端点）
TEST_LLM_BASE_URL=

# ----- Embedding 向量模型 [必填] -----
# 仅支持 openai 兼容 /embeddings；TEST_EMBEDDING_DIMENSIONS 必须等于
# knowledge_chunk.embedding 的列维度（当前 vector(2048)），测试装配会 fail-fast 校验；
# 且所选模型必须真正产出该维度：`dimensions` 会随请求下发，模型不支持截断时按原生维度
# 返回 → 装配层直接报「返回 N 维与配置不一致」的明确错误
TEST_EMBEDDING_MODEL=text-embedding-3-small
# 复制为 .env.test 后替换为真实 API Key
TEST_EMBEDDING_API_KEY=REPLACE_WITH_REAL_KEY
TEST_EMBEDDING_BASE_URL=https://api.openai.com/v1
TEST_EMBEDDING_DIMENSIONS=2048

# ----- Search 搜索供应商（Serper 兼容 API）[必填] -----
TEST_SEARCH_BASE_URL=https://google.serper.dev
# 复制为 .env.test 后替换为真实 API Key
TEST_SEARCH_API_KEY=REPLACE_WITH_REAL_KEY

# ----- 对象存储（本地 MinIO，docker compose 缺省值；测试用独立桶）-----
TEST_S3_ENDPOINT=http://localhost:9000
TEST_S3_BUCKET=tradepilot-test
TEST_S3_REGION=us-east-1
TEST_S3_ACCESS_KEY_ID=tradepilot
TEST_S3_SECRET_ACCESS_KEY=tradepilot_dev

# ----- 测试邮箱（本地 GreenMail，docker compose 缺省值；任意凭据可登录）-----
TEST_MAIL_HOST=127.0.0.1
TEST_MAIL_SMTP_PORT=1025
TEST_MAIL_IMAP_PORT=1114
TEST_MAIL_USER=greenmail
TEST_MAIL_PASSWORD=greenmail
